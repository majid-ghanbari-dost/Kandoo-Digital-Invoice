{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kandoo:mode-b:template-bank:1",
  "title": "Kandoo Mode B Template Bank Artifact v1",
  "description": "Versioned, store-scoped envelope around the E-05 TemplateBank.to_dict() representation. All geometry and numeric formats are data, not locale-dependent strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "mode",
    "store_id",
    "created_at",
    "template_bank"
  ],
  "properties": {
    "artifact_type": {
      "const": "kandoo.mode-b.template-bank"
    },
    "artifact_version": {
      "const": "1"
    },
    "mode": {
      "const": "B"
    },
    "store_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "template_bank": {
      "$ref": "#/$defs/templateBank"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "singleCharacter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1
    },
    "templateBank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_version",
        "confidence_threshold",
        "currency_unit",
        "templates"
      ],
      "properties": {
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "confidence_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "currency_unit": {
          "enum": ["rial", "toman", null]
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layoutTemplate"
          }
        }
      }
    },
    "layoutTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "source_invoice_ids",
        "row_count_min",
        "row_count_max",
        "known_row_counts",
        "normalized_column_boundaries",
        "median_row_height_over_width",
        "median_row_pitch_over_width",
        "median_row_height_cv",
        "table_top_over_width",
        "payable_gap_over_width",
        "payable_bbox_left_over_width",
        "payable_bbox_width_over_width",
        "payable_bbox_height_over_width",
        "field_positions",
        "digit_alphabet",
        "amount_thousands_separator",
        "amount_group_size"
      ],
      "properties": {
        "template_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "source_invoice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueId"
          }
        },
        "row_count_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "row_count_max": {
          "$ref": "#/$defs/positiveInteger"
        },
        "known_row_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/positiveInteger"
          }
        },
        "normalized_column_boundaries": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/unitInterval"
          }
        },
        "median_row_height_over_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median_row_pitch_over_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median_row_height_cv": {
          "type": "number",
          "minimum": 0
        },
        "table_top_over_width": {
          "type": "number",
          "minimum": 0
        },
        "payable_gap_over_width": {
          "type": "number"
        },
        "payable_bbox_left_over_width": {
          "$ref": "#/$defs/unitInterval"
        },
        "payable_bbox_width_over_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "payable_bbox_height_over_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "field_positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldPosition"
          }
        },
        "digit_alphabet": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/singleCharacter"
          }
        },
        "amount_thousands_separator": {
          "oneOf": [
            {
              "$ref": "#/$defs/singleCharacter"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_group_size": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "fieldPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_name",
        "x_start",
        "x_end",
        "y_start",
        "y_end",
        "y_reference"
      ],
      "properties": {
        "field_name": {
          "$ref": "#/$defs/opaqueId"
        },
        "x_start": {
          "$ref": "#/$defs/unitInterval"
        },
        "x_end": {
          "$ref": "#/$defs/unitInterval"
        },
        "y_start": {
          "type": "number"
        },
        "y_end": {
          "type": "number"
        },
        "y_reference": {
          "enum": [
            "row_fraction",
            "page_over_width"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "y_reference": {
                "const": "row_fraction"
              }
            },
            "required": ["y_reference"]
          },
          "then": {
            "properties": {
              "y_start": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y_end": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "y_reference": {
                "const": "page_over_width"
              }
            },
            "required": ["y_reference"]
          },
          "then": {
            "properties": {
              "y_start": {
                "type": "number",
                "minimum": 0
              },
              "y_end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
