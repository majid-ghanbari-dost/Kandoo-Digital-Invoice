{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kandoo:n05:product-candidate:v1",
  "title": "N-05 ProductCandidate v1 example",
  "description": "A versioned ProductCandidate sample with optional non-accepting name suggestions, crop provenance, and printed-date price observations. This is separate from the frozen Canonical Invoice contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_schema_version",
    "source_fixture_id",
    "source_fixture_file",
    "price_observation_date_source",
    "name_suggestions_enabled",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "n05.product-candidate.v1"
    },
    "source_schema_version": {
      "const": "n02.product-candidates.v1"
    },
    "source_fixture_id": {
      "enum": ["29", "31", "32", "33"]
    },
    "source_fixture_file": {
      "enum": [
        "tests/fixtures/real/canonical/canonical-29.json",
        "tests/fixtures/real/canonical/canonical-31.json",
        "tests/fixtures/real/canonical/canonical-32.json",
        "tests/fixtures/real/canonical/canonical-33.json"
      ]
    },
    "price_observation_date_source": {
      "const": "header.printed_date"
    },
    "name_suggestions_enabled": {
      "type": "boolean"
    },
    "candidate": {
      "$ref": "#/$defs/productCandidate"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_fixture_id": {"const": "29"}
        },
        "required": ["source_fixture_id"]
      },
      "then": {
        "properties": {
          "source_fixture_file": {
            "const": "tests/fixtures/real/canonical/canonical-29.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_fixture_id": {"const": "31"}
        },
        "required": ["source_fixture_id"]
      },
      "then": {
        "properties": {
          "source_fixture_file": {
            "const": "tests/fixtures/real/canonical/canonical-31.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_fixture_id": {"const": "32"}
        },
        "required": ["source_fixture_id"]
      },
      "then": {
        "properties": {
          "source_fixture_file": {
            "const": "tests/fixtures/real/canonical/canonical-32.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_fixture_id": {"const": "33"}
        },
        "required": ["source_fixture_id"]
      },
      "then": {
        "properties": {
          "source_fixture_file": {
            "const": "tests/fixtures/real/canonical/canonical-33.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name_suggestions_enabled": {"const": true}
        },
        "required": ["name_suggestions_enabled"]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "name_suggestions": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name_suggestions_enabled": {"const": false}
        },
        "required": ["name_suggestions_enabled"]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "name_suggestions": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "productCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_crop_cluster_id",
        "reference_crop_file",
        "occurrence_count",
        "quantity_sum",
        "source_crop_ids",
        "price_observations",
        "invoice_ids",
        "name_suggestions"
      ],
      "properties": {
        "name_crop_cluster_id": {
          "type": "string",
          "pattern": "^name-dhash-[0-9a-f]{16}$"
        },
        "reference_crop_file": {
          "type": "string",
          "pattern": "^tests/fixtures/real/n02-reference-crops/[0-9]+_row[0-9]+\\.png$"
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 1
        },
        "quantity_sum": {
          "type": "integer",
          "minimum": 1
        },
        "source_crop_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+_row[0-9]+$"
          }
        },
        "price_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/priceObservation"
          }
        },
        "invoice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^e05-synth-invoice-(29|31|32|33)$"
          }
        },
        "name_suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameSuggestion"
          }
        }
      }
    },
    "nameSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested_name",
        "lines",
        "confidence",
        "engine",
        "engine_version",
        "model_version",
        "crop_reference",
        "accepted"
      ],
      "properties": {
        "suggested_name": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {"type": "string"}
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "crop_reference": {
          "$ref": "#/$defs/cropReference"
        },
        "accepted": {
          "const": false
        }
      }
    },
    "cropReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crop_id", "file", "sha256"],
      "properties": {
        "crop_id": {
          "type": "string",
          "pattern": "^[0-9]+_row[0-9]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^tests/fixtures/real/n02-reference-crops/[0-9]+_row[0-9]+\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "priceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_on",
        "unit_price_rials",
        "invoice_id",
        "source_crop_id"
      ],
      "properties": {
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "unit_price_rials": {
          "type": "integer",
          "minimum": 1
        },
        "invoice_id": {
          "type": "string",
          "pattern": "^e05-synth-invoice-(29|31|32|33)$"
        },
        "source_crop_id": {
          "type": "string",
          "pattern": "^[0-9]+_row[0-9]+$"
        }
      }
    }
  }
}
